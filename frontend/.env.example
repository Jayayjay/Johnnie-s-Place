# Copy to .env.local for local dev. Points the SPA at the Django API.
VITE_API_URL=http://localhost:8000/api

# Google OAuth Web client ID for Sign in with Google (from Google Cloud Console).
# Must match the backend's GOOGLE_CLIENT_ID. Leave empty to show a setup note
# instead of the Google button.
VITE_GOOGLE_CLIENT_ID="1094136148154-lijjdfv2m26q950dfhtg2kihjl8bi98v.apps.googleusercontent.com"

# Bar WhatsApp Business number, international format, digits only (no +). Powers the
# "Order on WhatsApp" fallback for small / out-of-area orders. Empty → buttons disabled.
VITE_BAR_WHATSAPP=255744000000
