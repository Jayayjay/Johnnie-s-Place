# Copy to .env and adjust. Never commit the real .env.
SECRET_KEY=dev-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
TIME_ZONE=Africa/Dar_es_Salaam
# Delivery pricing + eligibility (TZS / km). Fee = BASE + PER_KM*(dist-FREE_KM) + VALUE_RATE*subtotal.
MIN_ONLINE_ORDER=50000
MAX_DELIVERY_KM=25
DELIVERY_BASE_FEE=3000
DELIVERY_PER_KM=1200
DELIVERY_FREE_KM=2
DELIVERY_VALUE_RATE=0.02
# Bar WhatsApp Business number in international format (digits only, no +). Used for the
# "order on WhatsApp" fallback. REQUIRED for that button to work.
BAR_WHATSAPP=255744000000
# Google OAuth Web client ID (from Google Cloud Console → Credentials). Required
# for Sign in with Google. Must match the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=1094136148154-lijjdfv2m26q950dfhtg2kihjl8bi98v.apps.googleusercontent.com
